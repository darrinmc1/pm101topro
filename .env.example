# Stripe (TTPN test mode — leave both flags false until Preview is checked)
# Server gate. POST /api/checkout and POST /api/stripe/webhook return 503 unless this is the string true.
STRIPE_ENABLED=false
# Baked into the client at build time. Buy buttons stay "Coming soon" unless this is the string true.
# A product with available: false stays "Coming soon" even when this is true.
NEXT_PUBLIC_STRIPE_ENABLED=false
# TTPN test secret (sk_test_…). Never commit the value.
STRIPE_SECRET_KEY=
# Signing secret for this site's test webhook endpoint. Never commit the value.
STRIPE_WEBHOOK_SECRET=
# Lookup-key prefix. Code builds pm101topro_pro_m_usd12 (USD 1200, monthly).
STRIPE_SITE_KEY=pm101topro
# Prebuilt Checkout does not need a publishable key. Leave blank unless a client SDK is added.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Public contact address for the footer, the Buy line, and refund copy.
# Leave unset to hide those lines. Do not use an @example.com address.
NEXT_PUBLIC_SUPPORT_EMAIL=

# Clerk Authentication
# Get your keys from https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Resend Email
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=

# Optional: After Sign-In/Sign-Up URLs
NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT=/dashboard

# Optional: From email address for transactional emails
# Must be a verified domain in Resend
RESEND_FROM_EMAIL=onboarding@resend.dev

# AI (Status Cleaner + document generator). Optional — tools fall back to a
# PM101 method draft when unset.
GOOGLE_API_KEY=
N8N_AI_WEBHOOK_URL=
