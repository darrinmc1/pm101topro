# Clerk Authentication
# Get your keys from https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Resend Email
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=

# Optional: After Sign-In/Sign-Up URLs
NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT=/dashboard

# Optional: From email address for transactional emails
# Must be a verified domain in Resend
RESEND_FROM_EMAIL=onboarding@resend.dev
