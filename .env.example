# Clerk — this site's own application for pm101topro.com.
# Leave both blank and the site still renders, with sign-in hidden.
# Production (pm101topro.com and www.pm101topro.com): the production instance,
# pk_live_ / sk_live_, Frontend API on clerk.pm101topro.com.
# Preview and local: the same application's development instance, pk_test_ / sk_test_.
# Do not paste another site's keys here.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Resend Email
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=

# Optional. The app already sends sign-in to /sign-in, sign-up to /sign-up,
# and both on to /dashboard. Set these only if you want the same paths in the
# Clerk dashboard's environment as well.
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL=/dashboard
# NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/dashboard

# Status Cleaner (and other Gemini calls). Optional — the tool falls back to a
# PM101 method draft when GOOGLE_API_KEY and N8N_AI_WEBHOOK_URL are unset.
GOOGLE_API_KEY=
N8N_AI_WEBHOOK_URL=
# Defaults to gemini-2.5-flash when unset.
GEMINI_MODEL=

# Optional: From email address for transactional emails
# Must be a verified domain in Resend
RESEND_FROM_EMAIL=onboarding@resend.dev

# n8n feedback webhook shared secret (server-only; never NEXT_PUBLIC_).
# Sent as X-KD7-Secret after a feedback save. If unset, the webhook is still
# called without the header.
KD7_WEBHOOK_SECRET=
