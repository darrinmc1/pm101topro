# Clerk Authentication
# Use keys from a Clerk application whose production domain is pm101topro.com
# (apex and www). A production key minted for another domain is ignored.
# https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Resend Email
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=

# Optional. Sign-in, sign-up, and the dashboard redirect are also set in code.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/dashboard

# Optional: From email address for transactional emails
# Must be a verified domain in Resend
RESEND_FROM_EMAIL=onboarding@resend.dev

# AI (Status Cleaner + document generator). Optional — tools fall back to a
# PM101 method draft when unset.
GOOGLE_API_KEY=
N8N_AI_WEBHOOK_URL=
